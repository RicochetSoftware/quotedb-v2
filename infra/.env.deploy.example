# Copy to infra/.env.deploy (gitignored), chmod 600, and fill in values.
# Load in your shell: set -a; source infra/.env.deploy; set +a
# Never paste tokens into chat or commit this filled-in file.
# doctl's saved login does not automatically authenticate OpenTofu.
DIGITALOCEAN_TOKEN=''
TF_VAR_cloudflare_api_token=''
TF_VAR_cloudflare_zone_id=''
# R2 account ID is also used in infra/terraform/backend.hcl.
CLOUDFLARE_ACCOUNT_ID=''
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
# Generate and save this securely: openssl rand -base64 32
TF_VAR_state_encryption_passphrase=''
TF_VAR_resend_api_key=''
TF_VAR_domain='quotes.elmu.dev'
TF_VAR_digitalocean_region='fra1'
TF_VAR_droplet_size='s-1vcpu-1gb'
# JSON array: deployment SSH public key and administrator public keys.
TF_VAR_ssh_public_keys='[]'

# Access (existing Zero Trust team). Token also needs Access Apps/Policies/IdPs Write.
TF_VAR_cloudflare_account_id=''
TF_VAR_access_team=''
TF_VAR_admin_hostname='admin-quotes.elmu.dev'
TF_VAR_admin_emails='["replace-with-admin@example.com"]'
# Reuse the account's existing OTP provider if available.
TF_VAR_access_otp_provider_id=''
# Used by deploy.sh and the static image build.
ADMIN_HOST='admin-quotes.elmu.dev'
