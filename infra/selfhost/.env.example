# Copy to .env next to compose.yaml.
# Public apex; DNS for <domain>, app., admin. and api. must point at this machine.
# This production stack requires a Cloudflare Access application. For local dev use pnpm dev.
DOMAIN=quotes.example.com
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
COOKIE_SECRET=
RESEND_API_KEY=
IZARO_USER_ID=
# Optional explicit collection UUID to publish via /izaro (overrides IZARO_USER_ID).
IZARO_COLLECTION_ID=

# Distinct first-level hostname with Cloudflare proxy + Access enabled.
ADMIN_HOST=admin-quotes.example.com
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
# openssl rand -hex 32
AUTH_CODE_SECRET=
