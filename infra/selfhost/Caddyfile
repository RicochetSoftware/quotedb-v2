# Whole QuoteDB stack behind one Caddy with automatic TLS. Hosts are derived from $DOMAIN,
# matching production: <domain> (site), app.<domain>, admin.<domain>, api.<domain>.
(static_assets) {
	encode zstd gzip
	# Vite (/assets) and Astro (/_astro) emit content-hashed filenames.
	@hashed path /assets/* /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header -Server
}

# SPA: unknown paths fall back to index.html (TanStack Router handles routing).
(spa) {
	import static_assets
	try_files {path} /index.html
	file_server
}

{$DOMAIN} {
	root * /srv/site
	import static_assets
	try_files {path} {path}/ {path}.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

app.{$DOMAIN} {
	root * /srv/web
	import spa
}

admin.{$DOMAIN} {
	redir https://{$ADMIN_HOST}{uri} permanent
}

{$ADMIN_HOST} {
	tls /etc/caddy/admin-origin.crt /etc/caddy/admin-origin.key
	# Validate Access at the origin too, including static pages. A direct-origin
	# request cannot bypass the Cloudflare login page by supplying only Host.
	header Cache-Control "private, no-store"
	handle /_monitor/health {
		reverse_proxy api:8080
	}
	handle /api/v1/admin/* {
		reverse_proxy api:8080
	}
	handle {
		forward_auth api:8080 {
			uri /api/v1/admin/me
		}
		root * /srv/admin
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}

api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}

# Docker network only; never publish 8091 on the host. Used by authenticated health-only API.
:8091 {
  root * /srv/admin
  file_server
}
