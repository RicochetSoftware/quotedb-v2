{
  "uid": "quotedb-status-monitor",
  "title": "Status monitoring unavailable",
  "folderUID": "quotedb",
  "ruleGroup": "QuoteDB operations",
  "condition": "C",
  "noDataState": "Alerting",
  "execErrState": "Alerting",
  "for": "3m",
  "isPaused": false,
  "labels": {
    "project": "quotedb",
    "severity": "warning"
  },
  "annotations": {
    "summary": "The public status endpoint is unavailable, monitoring is stale, or the independent collector is missing. Check Cloudflare and the Droplet independently.",
    "runbook_url": "https://github.com/RicochetSoftware/quotedb-v2/blob/master/infra/observability/README.md"
  },
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "datasourceUid": "grafanacloud-prom",
      "model": {
        "refId": "A",
        "expr": "1 - (max(probe_success{project=\"quotedb\",job=\"integrations/blackbox/quotedb-status-external\"}) or vector(0))",
        "instant": true,
        "range": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "C",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "A",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                0
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "C"
              ]
            },
            "reducer": {
              "type": "last",
              "params": []
            },
            "type": "query"
          }
        ]
      }
    }
  ]
}
