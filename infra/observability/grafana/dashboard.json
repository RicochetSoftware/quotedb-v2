        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 9,
        "title": "Bot gateway latency and reconnects",
        "description": "Bot gateway latency and reconnects",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 12,
          "y": 29,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "quotedb_bot_gateway_latency_seconds",
            "legendFormat": "Gateway latency",
            "range": true
          },
          {
            "refId": "B",
            "expr": "increase(quotedb_bot_reconnects_total[5m])",
            "legendFormat": "Reconnects / 5m",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byFrameRefID",
                "options": "B"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "short"
                },
                {
                  "id": "custom.axisPlacement",
                  "value": "right"
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 10,
        "title": "Host CPU busy",
        "description": "Host CPU busy",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 0,
          "y": 37,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "1 - avg(rate(node_cpu_seconds_total{project=\"quotedb\",mode=\"idle\"}[5m]))",
            "legendFormat": "CPU busy",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
