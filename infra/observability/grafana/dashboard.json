        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 12,
        "title": "Host disk usage",
        "description": "Host disk usage",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 0,
          "y": 45,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "1 - node_filesystem_avail_bytes{project=\"quotedb\",fstype=~\"ext4|xfs\"} / node_filesystem_size_bytes{project=\"quotedb\",fstype=~\"ext4|xfs\"}",
            "legendFormat": "{{mountpoint}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": {
              "mode": "palette-classic"
            },
