{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "quotedb-performance",
    "annotations": {
      "grafana.app/folder": "quotedb"
    }
  },
  "spec": {
    "title": "QuoteDB \u00b7 Service performance",
    "uid": "quotedb-performance",
    "schemaVersion": 39,
    "version": 1,
    "tags": [
      "quotedb",
      "observability"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "title": "Service availability",
        "description": "Same component states as the public page. Data older than 180 seconds becomes Unknown; absent data is not green.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 5
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(last_over_time(quotedb_component_state[1h]) * on(component) (time() - last_over_time(quotedb_evaluation_timestamp_seconds[1h]) <= bool 180)) + on(component) (3 * (time() - last_over_time(quotedb_evaluation_timestamp_seconds[1h]) > bool 180))",
            "legendFormat": "{{component}}",
            "range": false,
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "Unknown",
            "displayName": "${__field.labels.component}",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Operational",
                    "color": "green"
                  },
                  "1": {
                    "text": "Elevated latency",
                    "color": "yellow"
                  },
                  "2": {
                    "text": "Unavailable",
                    "color": "red"
                  },
                  "3": {
                    "text": "Unknown",
                    "color": "gray"
                  },
                  "4": {
                    "text": "Maintenance",
                    "color": "blue"
                  }
                }
              }
            ],
            "color": {
              "mode": "fixed",
              "fixedColor": "gray"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "horizontal",
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 2,
        "title": "External probe / gateway latency",
        "description": "HTTP probe duration and separate bot gateway latency. Thresholds: HTTP 1500 ms; bot gateway 500 ms.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "quotedb_probe_duration_milliseconds",
            "legendFormat": "{{component}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 3,
        "title": "Monitoring freshness",
        "description": "Age of the last exported evaluation. Above 180 seconds, availability is unknown. A rise can indicate scheduler or export failure.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 12,
          "y": 5,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "time() - last_over_time(quotedb_evaluation_timestamp_seconds[1h])",
            "legendFormat": "{{component}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 4,
        "title": "API response latency",
        "description": "API response latency",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 0,
          "y": 13,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.5, sum by (le) (rate(quotedb_api_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p50",
            "range": true
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum by (le) (rate(quotedb_api_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p95",
            "range": true
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum by (le) (rate(quotedb_api_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p99",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 5,
        "title": "API traffic by normalized route",
        "description": "API traffic by normalized route",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 12,
          "y": 13,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (route) (rate(quotedb_api_request_duration_seconds_count[5m]))",
            "legendFormat": "{{route}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 6,
        "title": "API server error ratio",
        "description": "API server error ratio",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 0,
          "y": 21,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(rate(quotedb_api_request_duration_seconds_count{status_class=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(quotedb_api_request_duration_seconds_count[5m])), 0.000001)",
            "legendFormat": "5xx fraction",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 7,
        "title": "Bot command latency p95",
        "description": "Populated by real Discord interactions; no samples means no observed commands, not a measured zero latency.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 12,
          "y": 21,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (le,kind) (rate(quotedb_bot_command_duration_seconds_bucket[5m])))",
            "legendFormat": "{{kind}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 8,
        "title": "Bot command outcomes",
        "description": "Populated by real Discord interactions; no samples means no observed commands, not a measured zero latency.",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "gridPos": {
          "x": 0,
          "y": 29,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (outcome) (rate(quotedb_bot_command_duration_seconds_count[5m]))",
            "legendFormat": "{{outcome}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 8,
              "showPoints": "never"
            }
          },
          "overrides": []
