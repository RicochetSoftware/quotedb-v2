# Install as /opt/quotedb/bot.env (mode 600), or supply DISCORD_BOT_ENV in CI.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
QUOTEDB_API_URL=http://api:8080
QUOTEDB_PUBLIC_URL=https://quotes.example
# URL-encode the password; migration bootstraps quotedb_bot with this password.
BOT_DATABASE_URL=postgres://quotedb_bot:replace-with-a-strong-password@postgres:5432/quotedb
# Generate once: openssl rand -hex 32. Retain separately from database backups.
BOT_ENCRYPTION_KEY=
