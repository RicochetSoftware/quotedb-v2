{
  "name": "@quotedb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@quotedb/shared": "workspace:*",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "jose": "^6.2.14",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "typebox": "1.4.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
