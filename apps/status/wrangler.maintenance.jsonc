{
  "name": "quotedb-status-maintenance",
  "main": "src/maintenance.ts",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quotedb-status",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "minify": true
}
