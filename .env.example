# Copy to .env for local development. Production values are set by OpenTofu (infra/terraform).

# ── API ──
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://quotedb:quotedb@localhost:5432/quotedb
# Any 32+ char random string: openssl rand -base64 48
COOKIE_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5180
ADMIN_URL=http://localhost:5181
# Leave empty locally (host-only cookie). In prod: .<domain>
COOKIE_DOMAIN=
MAIL_FROM="QuoteDB <no-reply@localhost>"
# Mailpit (docker compose); UI at http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Set in production to send through Resend instead of SMTP_URL
RESEND_API_KEY=
# Have I Been Pwned check on new passwords
HIBP_ENABLED=true
# User whose quotes /izaro shows (UUID or legacy integer id). Seed data uses 2.
IZARO_USER_ID=2
LOG_LEVEL=info

# ── Frontends (Vite) ──
# Empty = same origin; the Vite dev servers proxy /api to the API.
VITE_API_URL=
VITE_WEB_URL=http://localhost:5180
VITE_ADMIN_URL=http://localhost:5181
